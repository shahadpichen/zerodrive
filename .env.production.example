# Copy this file to .env.production on the server, set mode 600, and replace
# every CHANGE_ME value. Keep the master copy of each secret in 1Password.

# Public deployment origins
REACT_APP_API_URL=https://api.zerodrive.xyz/api
REACT_APP_SITE_ORIGIN=https://zerodrive.xyz
APP_URL=https://zerodrive.xyz
ALLOWED_ORIGINS=https://zerodrive.xyz

# This value is public in the browser bundle and is required only for
# historical pre-Capsule sharing-key backups. Leave empty on a fresh install.
REACT_APP_RSA_PBKDF2_SALT=

# API runtime
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL bootstrap/migration owner. The long-running API never receives
# these credentials.
DB_NAME=zerodrive
DB_ADMIN_USER=zerodrive_owner
DB_ADMIN_PASSWORD=CHANGE_ME_RANDOM_DATABASE_OWNER_PASSWORD

# Restricted PostgreSQL runtime role used by the API.
DB_USER=zerodrive_app
DB_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Application security. Generate independent values; never reuse them.
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARACTERS
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
EMAIL_HASH_SALT=CHANGE_ME_RANDOM_LEGACY_IDENTITY_SALT
DIRECTORY_HMAC_SECRET=CHANGE_ME_DIFFERENT_RANDOM_64_HEX_CHARACTERS

# Google OAuth
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://api.zerodrive.xyz/api/auth/callback/google

# MinIO bootstrap administrator. These credentials are used only by the MinIO
# container and the one-shot setup job. The API must never receive them.
MINIO_ROOT_USER=CHANGE_ME_RANDOM_MINIO_ADMIN_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_RANDOM_MINIO_ADMIN_PASSWORD_AT_LEAST_32_CHARACTERS

# Bucket-scoped API service account. Use different values from the administrator
# above. The API uses the private service name and signs URLs for the public TLS
# endpoint with this restricted account.
MINIO_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MINIO_BUCKET=zerodrive-files
MINIO_PUBLIC_ENDPOINT=https://files.zerodrive.xyz

# Mailgun
MAILGUN_API_KEY=CHANGE_ME
MAILGUN_DOMAIN=zerodrive.xyz
MAILGUN_FROM_NAME=ZeroDrive
MAILGUN_FROM_EMAIL=notifications@zerodrive.xyz
MAILGUN_WEBHOOK_SIGNING_KEY=CHANGE_ME

# Privacy-safe aggregate analytics
ANALYTICS_ENABLED=true
ANALYTICS_ADMIN_EMAILS=CHANGE_ME_ADMIN_GOOGLE_EMAIL

# Legal versions. Bump when the published documents materially change.
LEGAL_TERMS_VERSION=2026-08
LEGAL_PRIVACY_VERSION=2026-08
