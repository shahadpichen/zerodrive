{
  "name": "zerodrive",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-knowledge encrypted cloud storage — root tooling (formatting)",
  "scripts": {
    "format": "prettier --write \"{app,backend}/src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"{app,backend}/src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  }
}
