# ZeroDrive Frontend Environment Variables

# Backend API URL
REACT_APP_API_URL=http://localhost:3001/api

# Canonical public origin used by SEO metadata and generated public resources
REACT_APP_SITE_ORIGIN=https://zerodrive.xyz

# Public compatibility salt used only to open historical, pre-Capsule sharing
# key backups. New Capsule backups do not use it. It is embedded in the web
# bundle and must never be treated as a server secret.
REACT_APP_RSA_PBKDF2_SALT=your-rsa-key-salt-change-in-production
